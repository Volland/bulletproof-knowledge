#lf
% ANCHOR: people
person : type.
anna  : person.
marco : person.
lena  : person.
taras : person.
sofia : person.
% ANCHOR_END: people

% ANCHOR: reports
reports : person -> person -> type.
r_marco : reports marco anna.
r_taras : reports taras lena.
r_anna  : reports anna lena.  % after the reorg
% ANCHOR_END: reports

% ANCHOR: under
under : person -> person -> type.
under_one  : under X Y <- reports X Y.
under_step : under X Z
               <- reports X Y
               <- under Y Z.
% ANCHOR_END: under
